{
  "$ref": "#/definitions/ItemKey",
  "definitions": {
    "ItemKey": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "itemId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+-w\\d{2}-(mon|tue|wed|thu|fri)$"
        },
        "answerSource": {
          "type": "string",
          "enum": [
            "official",
            "generated"
          ]
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "pending",
            "approved"
          ]
        },
        "officialRef": {
          "type": "object",
          "properties": {
            "pdf": {
              "type": "string"
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            }
          },
          "required": [
            "pdf",
            "pages"
          ],
          "additionalProperties": false
        },
        "answers": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "explanationZh": {
                    "type": "string"
                  },
                  "tipsZh": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "block": {
                          "type": "string"
                        },
                        "quote": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "block",
                        "quote"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "correct": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "correct"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "explanationZh": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/explanationZh"
                  },
                  "tipsZh": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/tipsZh"
                  },
                  "evidence": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/evidence"
                  },
                  "slots": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "accept": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1
                        },
                        "caseSensitive": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "accept"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "slots"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "explanationZh": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/explanationZh"
                  },
                  "tipsZh": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/tipsZh"
                  },
                  "evidence": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/evidence"
                  },
                  "pairs": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "pairs"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "explanationZh": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/explanationZh"
                  },
                  "tipsZh": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/tipsZh"
                  },
                  "evidence": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/evidence"
                  },
                  "sequence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "sequence"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "explanationZh": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/explanationZh"
                  },
                  "tipsZh": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/tipsZh"
                  },
                  "evidence": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/evidence"
                  },
                  "sequences": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "sequences"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "explanationZh": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/explanationZh"
                  },
                  "tipsZh": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/tipsZh"
                  },
                  "evidence": {
                    "$ref": "#/definitions/ItemKey/properties/answers/additionalProperties/anyOf/0/properties/evidence"
                  },
                  "sampleAnswer": {
                    "type": "string"
                  },
                  "rubricZh": {
                    "type": "string"
                  },
                  "rubricType": {
                    "type": "string",
                    "enum": [
                      "content",
                      "opinion"
                    ]
                  },
                  "keyPoints": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "descZh": {
                          "type": "string"
                        },
                        "examples": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "weight": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "id",
                        "descZh",
                        "weight"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "match": {
                    "type": "string",
                    "enum": [
                      "all",
                      "any"
                    ]
                  },
                  "anchors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "response": {
                          "type": "string"
                        },
                        "score": {
                          "type": "number",
                          "minimum": 0
                        },
                        "noteZh": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "response",
                        "score"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "sampleAnswer"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "itemId",
        "answerSource",
        "reviewStatus",
        "answers"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
