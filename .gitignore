node_modules/
dist/
.DS_Store
# source PDFs are large (100MB+); keep out of git
articles/*.pdf
# rendered page images (regenerable via scripts/render.swift)
.work/
test-results/
playwright-report/
.vercel
.env*
*.tsbuildinfo
# audio/video are delivered assets, not source: regenerate with scripts/audio.mjs, shipped as rc-media-<playlist>.zip
content/assets/**/*.m4a
content/assets/**/*.mp3
content/assets/**/*.mp4
# UniRead ui-style-kit: the kit's default fonts are not used (the project uses its Figma fonts)
ui-style-kit/fonts/

# OSS credentials handed over privately (#130): never commit — keep them outside the repo
*private*/
*.private.*
uniread-oss-private-*

# UniRead design-system snapshot (42 MB, mostly preview images): kept locally, pinned by sha256 in design-system/lock.json
docs/uniread-spec/design-system/*.html
