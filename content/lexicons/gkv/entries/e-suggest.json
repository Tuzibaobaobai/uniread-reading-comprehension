  ],
  "examples": [
    {
      "en": [
        {
          "t": "text",
          "v": "The teacher "
        },
        {
          "t": "underline",
          "v": "suggests"
        },
        {
          "t": "text",
          "v": " that all the students should learn how to look up words in a dictionary."
        }
      ],
      "zh": "老师建议所有的学生都该学会怎么使用词典来查词。"
    }
  ],
  "phrases": [
    {
      "en": "suggest doing sth.",
      "zh": "建议做某事"
    },
    {
      "en": "suggest that ...",
      "zh": "建议……"
    }
