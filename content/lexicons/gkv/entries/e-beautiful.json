  "examples": [
    {
      "en": [
        {
          "t": "text",
          "v": "No scenery is more "
        },
        {
          "t": "underline",
          "v": "beautiful"
        },
        {
          "t": "text",
          "v": " than what I am enjoying here."
        }
      ],
      "zh": "没有什么风景能比得上我现在看到的景色。"
    }
  ],
  "wordFamily": [
    {
