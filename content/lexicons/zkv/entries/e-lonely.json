  "examples": [
    {
      "en": [
        {
          "t": "text",
          "v": "He doesn’t feel "
        },
        {
          "t": "underline",
          "v": "lonely"
        },
        {
          "t": "text",
          "v": " when he is left alone."
        }
      ],
