  "examples": [
    {
      "en": [
        {
          "t": "text",
          "v": "I "
        },
        {
          "t": "underline",
          "v": "apologized"
        },
        {
          "t": "text",
          "v": " to the girl for my being late."
        }
      ],
      "zh": "我因为迟到而向那位女孩道歉。"
    }
  ],
  "phrases": [
    {
      "en": "apologize to sb. for sth.",
