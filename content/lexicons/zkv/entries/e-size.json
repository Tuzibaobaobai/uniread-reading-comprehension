  "tip": [
    {
      "id": "p1",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "size 是常考单词，常出现在保持句意基本不变的句型转换练习中，所以学生一定要知道：nearly the size of 与 nearly as small/big as（大小近似）意思相同，在句中可以互换。"
        }
      ]
    },
    {
      "id": "p2",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "例如：The robot on the desk is "
        },
        {
          "t": "underline",
          "v": "nearly the size of"
        },
        {
          "t": "text",
          "v": " a match box."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "= The robot on the desk is "
        },
        {
          "t": "underline",
          "v": "nearly as small as"
        },
        {
          "t": "text",
          "v": " a match box."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "桌上那个机器人只有火柴盒那么大。"
        }
      ]
    }
  ],
