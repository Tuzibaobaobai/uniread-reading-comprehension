  "schemaVersion": "1.0",
  "id": "e-in-one-s-fifties",
  "lexicon": "zkv",
  "number": 179,
  "kind": "phrase",
  "headword": "in one’s fifties",
  "star": true,
  "senses": [
    {
      "zh": "在某人 50 多岁时"
    }
  ],
  "examples": [
    {
      "en": [
        {
          "t": "text",
          "v": "Professor Brown is still very active and enjoys hiking even though he is already "
        },
        {
          "t": "underline",
          "v": "in his fifties"
        },
        {
          "t": "text",
          "v": "."
        }
      ],
      "zh": "尽管布朗教授已经 50 多岁了，他仍然非常活跃，喜欢徒步旅行。"
    }
  ],
  "tip": [
    {
      "id": "p1",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "in one’s fifties 是常考词组，常出现在保持句意基本不变的句型转换练习中，所以学生一定要知道：in his sixties 与 when he was over sixty 意思相同，在句中可以互换。"
        }
      ]
    },
    {
      "id": "p2",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "例如：My grandpa began to learn how to use a computer "
        },
        {
          "t": "underline",
          "v": "in his sixties"
        },
        {
          "t": "text",
          "v": "."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "= My grandpa began to learn how to use a computer "
        },
        {
          "t": "underline",
          "v": "when he was over sixty"
        },
        {
          "t": "text",
          "v": "."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "我爷爷在他 60 多岁时开始学习如何使用电脑。"
        }
      ]
    }
  ],
