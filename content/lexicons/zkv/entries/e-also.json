  "tip": [
    {
      "id": "p1",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "also 是常考单词，常出现在保持句意基本不变的句型转换练习中，所以学生一定要知道：also 与 too 和 as well 意思相同，在句中可以互换；"
        },
        {
          "t": "strong",
          "v": "also"
        },
        {
          "t": "text",
          "v": " 一般位于句中，而 "
        },
        {
          "t": "strong",
          "v": "too"
        },
        {
          "t": "text",
          "v": " 和 "
        },
        {
          "t": "strong",
          "v": "as well"
        },
        {
          "t": "text",
          "v": " 位于句末。"
        }
      ]
    },
    {
      "id": "p2",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "例如：He "
        },
        {
          "t": "underline",
          "v": "also"
        },
        {
          "t": "text",
          "v": " plays the piano."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "= He plays the piano, "
        },
        {
          "t": "underline",
          "v": "too"
        },
        {
          "t": "text",
          "v": "."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "= He plays the piano "
        },
        {
          "t": "underline",
          "v": "as well"
        },
        {
          "t": "text",
          "v": "."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "他也弹钢琴。"
        }
      ]
    }
  ],
