{
  "schemaVersion": "1.0",
  "id": "e-expect",
  "lexicon": "zkv",
  "number": 545,
  "kind": "word",
  "headword": "expect",
  "ipa": [
    "ɪkˈspekt"
  ],
  "star": true,
  "levelMark": true,
  "textbook": [
    "G7上U5"
  ],
  "senses": [
    {
      "pos": "v.",
      "zh": "预料；期望，期待；认为"
    }
  ],
  "examples": [
    {
      "en": [
        {
          "t": "text",
          "v": "Ben and Lily have one child and they are "
        },
        {
          "t": "underline",
          "v": "expecting"
        },
        {
          "t": "text",
          "v": " the second one in July."
        }
      ],
      "zh": "本和莉莉有一个孩子，他们预计 7 月份迎来第 2 个孩子。"
    },
    {
      "en": [
        {
          "t": "text",
          "v": "Grandparents just called to say that they "
        },
        {
          "t": "underline",
          "v": "expected"
        },
        {
          "t": "text",
          "v": " us to visit them very often."
        }
      ],
      "zh": "爷爷奶奶刚打电话来，说希望我们能经常去看望他们。"
    }
  ],
  "tip": [
    {
      "id": "p1",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "expect 是常考单词，常出现在保持句意基本不变的句型转换练习中，所以学生一定要知道：expect 与 look forward to 意思相同，在句中可以互换。"
        }
      ]
    },
    {
      "id": "p2",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "例如：I’"
        },
        {
          "t": "underline",
          "v": "m expecting"
        },
        {
          "t": "text",
          "v": " to receive a letter from you."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "= I’"
        },
        {
          "t": "underline",
          "v": "m looking forward to"
        },
        {
          "t": "text",
          "v": " hearing from you."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "我期待收到你的来信。"
        }
      ]
    }
  ],
