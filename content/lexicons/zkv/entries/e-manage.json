  "tip": [
    {
      "id": "p1",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "manage 是常考单词，常出现在保持句意基本不变的句型转换练习中，所以学生一定要知道：manage to do 与 succeed in doing 意思相同，在句中可以互换。"
        }
      ]
    },
    {
      "id": "p2",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "例如：We "
        },
        {
          "t": "underline",
          "v": "have managed to drag"
        },
        {
          "t": "text",
          "v": " the fallen tree clear of the road."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "= We "
        },
        {
          "t": "underline",
          "v": "have succeeded in dragging"
        },
        {
          "t": "text",
          "v": " the fallen tree clear of the road."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "我们已经成功地把那棵倒下的树拖离道路。"
        }
      ]
    }
  ],
