      "id": "p1",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "used to 是常考词组，常出现在保持句意基本不变的句型转换练习中，所以学生一定要知道：used to do 与 often did 意思相同，在句中可以互换。"
        }
      ]
    },
