    },
    {
      "id": "p2",
      "type": "paragraph",
      "content": [
        {
          "t": "strong",
          "v": "among"
        },
        {
          "t": "text",
          "v": " 指“三者或三者以上之间”，"
        },
        {
          "t": "strong",
          "v": "between"
        },
        {
          "t": "text",
          "v": " 指“两者之间”。"
        }
      ]
    },
    {
      "id": "p3",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "例如：The teacher was "
