  "examples": [
    {
      "en": [
        {
          "t": "text",
          "v": "As middle school students, we should know how to "
        },
        {
          "t": "underline",
          "v": "look after"
        },
        {
          "t": "text",
          "v": " ourselves."
        }
      ],
      "zh": "作为中学生，我们应该知道如何照顾自己。"
    }
  ],
  "tip": [
    {
      "id": "p1",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "look after 是常考词组，常出现在保持句意基本不变的句型转换练习中，所以学生一定要知道：look after 与 take care of 意思相同，在句中可以互换。"
        }
      ]
    },
    {
      "id": "p2",
      "type": "paragraph",
      "content": [
        {
          "t": "text",
          "v": "例如：You’d better "
        },
        {
          "t": "underline",
          "v": "look after"
        },
        {
          "t": "text",
          "v": " your younger brother, Tom."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "= You’d better "
        },
        {
          "t": "underline",
          "v": "take care of"
        },
        {
          "t": "text",
          "v": " your younger brother, Tom."
        },
        {
          "t": "br"
        },
        {
          "t": "text",
          "v": "你最好照顾你的弟弟，汤姆。"
        }
      ]
    }
  ],
