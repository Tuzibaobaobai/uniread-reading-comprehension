  "answers": {
    "q1": {
      "slots": {
        "b1": {
          "accept": [
            "invisible"
          ]
        }
      },
      "explanationZh": "visible 是“看得见的”，这里说“看不见的”痕迹，加否定前缀 in- 变成 invisible，作定语修饰 marks。",
      "evidence": [
        {
          "block": "p1",
          "quote": "But perhaps a few will leave"
        }
      ]
    },
    "q2": {
      "slots": {
        "b2": {
          "accept": [
            "Recently",
            "recently"
          ]
        }
      },
      "explanationZh": "句子结构已经完整，句首需要副词表示“最近”，所以把形容词 recent 变成副词 Recently（句首要大写）。",
      "evidence": [
        {
          "block": "p1",
          "quote": "such marks were found in an ancient book"
        }
      ]
    },
    "q3": {
      "slots": {
        "b3": {
          "accept": [
            "hidden"
          ]
        }
      },
      "explanationZh": "空前是动词 find，空后是名词 information，用 hide 的过去分词 hidden 作定语，意思是“隐藏的”。",
      "evidence": [
        {
          "block": "p2",
          "quote": "to find"
        }
      ]
    },
    "q4": {
      "slots": {
        "b4": {
          "accept": [
            "eighth"
          ]
        }
      },
      "explanationZh": "修饰名词 century 要用序数词：the eighth century（八世纪）。",
      "evidence": [
        {
          "block": "p2",
          "quote": "It was produced in England in the"
        }
      ]
    },
    "q5": {
      "slots": {
        "b5": {
          "accept": [
            "left"
          ]
        }
      },
      "explanationZh": "may have 后面接过去分词，表示对过去的推测“可能留下了”，leave 的过去分词是 left。",
      "evidence": [
        {
          "block": "p2",
          "quote": "A lady named Eadburg may have"
        }
      ]
    },
    "q6": {
      "slots": {
        "b6": {
          "accept": [
            "written"
          ]
        }
      },
      "explanationZh": "名字“被写”出来，要用被动语态 is written，write 的过去分词是 written。",
      "evidence": [
        {
          "block": "p3",
          "quote": "Her name, “EADBURG”, is"
        }
      ]
    },
    "q7": {
      "slots": {
        "b7": {
          "accept": [
            "another"
          ]
        }
      },
      "explanationZh": "“还有另外十次”用 another ten times，another 可以接数字加复数名词。",
      "evidence": [
        {
          "block": "p3",
          "quote": "It appears"
        }
      ]
    },
    "q8": {
      "slots": {
        "b8": {
          "accept": [
            "drawings"
          ]
        }
      },
      "explanationZh": "one of the 后面接复数名词，所以 draw 变成名词复数 drawings。",
      "evidence": [
        {
          "block": "p4",
          "quote": "One of the"
        }
      ]
    },
