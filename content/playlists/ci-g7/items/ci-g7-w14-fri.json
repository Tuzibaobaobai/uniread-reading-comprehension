    "blocks": [
      {
        "id": "d1",
        "type": "dialogue",
        "legend": "T—Tom  S—Sunshine Real Estate Agency",
        "turns": [
          {
            "speaker": "S",
            "content": [
              {
                "t": "text",
                "v": "Good morning! This is Sunshine "
              },
              {
                "t": "vocab",
                "v": "Real Estate",
                "ref": "v-real-estate"
              },
              {
                "t": "text",
                "v": " Agency. What can I do for you?"
              }
            ]
          },
          {
            "speaker": "T",
            "content": [
              {
                "t": "text",
                "v": "Good morning! I am looking for a flat to rent. Could you help me?"
              }
            ]
          },
          {
            "speaker": "S",
            "content": [
              {
                "t": "text",
                "v": "Yeah, sure. Where do you want the flat to be?"
              }
            ]
          },
          {
            "speaker": "T",
            "content": [
              {
                "t": "text",
                "v": "I’d like a flat in Pudong New District. My office is near Century Avenue. A flat close to it would be great."
              }
            ]
          },
          {
            "speaker": "S",
            "content": [
              {
                "t": "text",
                "v": "OK. There is one flat for rent nearby. It has one bedroom, one kitchen and one bathroom."
              }
            ]
          },
          {
            "speaker": "T",
            "content": [
              {
                "t": "text",
                "v": "That’s perfect. How much is the rent?"
              }
            ]
          },
          {
            "speaker": "S",
            "content": [
              {
                "t": "text",
                "v": "It is 3,000 "
              },
              {
                "t": "em",
                "v": "yuan"
              },
              {
                "t": "text",
                "v": " per month. The security "
              },
              {
                "t": "gloss",
                "v": "deposit",
                "zh": "保证金"
              },
              {
                "t": "text",
                "v": " is 3,000 "
              },
              {
                "t": "em",
                "v": "yuan"
              },
              {
                "t": "text",
                "v": "."
              }
            ]
          },
          {
            "speaker": "T",
            "content": [
              {
                "t": "text",
                "v": "Are pets allowed?"
              }
            ]
          },
          {
            "speaker": "S",
            "content": [
              {
                "t": "text",
                "v": "Small pets are allowed, but there will be an "
              },
              {
                "t": "vocab",
                "v": "extra",
                "ref": "v-extra"
              },
              {
                "t": "text",
                "v": " security deposit of 500 "
              },
              {
                "t": "em",
                "v": "yuan"
              },
              {
                "t": "text",
                "v": "."
              }
            ]
          },
          {
            "speaker": "T",
            "content": [
              {
                "t": "text",
                "v": "OK. The rent is a little bit high. Can I get a "
              },
              {
                "t": "vocab",
                "v": "discount",
                "ref": "v-discount"
              },
              {
                "t": "text",
                "v": "?"
              }
            ]
          },
          {
            "speaker": "S",
            "content": [
              {
                "t": "text",
                "v": "I’m not sure. I will ask the "
              },
              {
                "t": "vocab",
                "v": "landlord",
                "ref": "v-landlord"
              },
              {
                "t": "text",
                "v": "."
              }
            ]
          },
          {
            "speaker": "T",
            "content": [
              {
                "t": "text",
                "v": "Thank you. Can I come to see the flat tomorrow morning?"
              }
            ]
          },
          {
            "speaker": "S",
            "content": [
              {
                "t": "text",
                "v": "Sure. Is 10 o’clock okay with you?"
              }
            ]
          },
          {
            "speaker": "T",
            "content": [
              {
                "t": "text",
                "v": "Yes, that will be fine."
              }
            ]
          },
          {
            "speaker": "S",
            "content": [
              {
                "t": "text",
                "v": "OK. See you then."
              }
            ]
          },
          {
            "speaker": "T",
            "content": [
              {
                "t": "text",
                "v": "See you."
              }
            ]
          }
        ]
      }
    ]
