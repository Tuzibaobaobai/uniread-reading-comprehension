        "pos": "adj.",
        "meaningZh": "暴力的；剧烈的"
      },
      {
        "id": "v-force",
        "headword": "force",
        "ipa": "fɔːs",
        "pos": "n.",
        "meaningZh": "武力，力量"
      },
      {
        "id": "v-suffer",
        "headword": "suffer",
        "ipa": "ˈsʌfə(r)",
        "pos": "v.",
        "meaningZh": "受苦，受难"
      },
      {
        "id": "v-hand-over",
        "headword": "hand over",
        "meaningZh": "移交，转交"
      },
      {
        "id": "v-defeat",
