        "ipa": "dɪˈfiːt",
        "pos": "n.",
        "meaningZh": "击败；挫败"
      },
      {
        "id": "v-wealth",
        "headword": "wealth",
        "ipa": "welθ",
        "pos": "n.",
        "meaningZh": "财富；财产"
      }
    ]
  },
  "sections": [
    {
      "id": "s1",
      "instruction": "Choose the best answer.",
      "questions": [
        {
          "id": "q1",
          "number": 1,
          "points": 1,
          "skills": [
            "vocab_in_context"
          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "What does the phrase “beat swords into plowshares” most likely mean in the context of this article?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "To turn war into peace."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "To destroy all weapons and build factories."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "To use swords to protect the plowshares."
                  }
                ]
              },
              {
                "id": "D",
                "content": [
                  {
                    "t": "text",
                    "v": "To fight against enemies who use plowshares."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q2",
          "number": 2,
          "points": 1,
          "skills": [
            "detail"
          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "What was the Five Dynasties and Ten Kingdoms period like?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "A time of war and suffering."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "A time of peace and happiness."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "A time when everyone had enough to eat."
                  }
                ]
              },
              {
                "id": "D",
                "content": [
                  {
                    "t": "text",
                    "v": "A time when China was united under one ruler."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q3",
          "number": 3,
          "points": 1,
          "skills": [
            "detail"
          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "What difficult decision did Qian Hongchu face near the end of his reign?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "Whether to go on fighting or give up."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "Whether to burn his own city or surrender."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "Whether to kill his own army or join the Song dynasty."
                  }
                ]
              },
              {
                "id": "D",
                "content": [
                  {
                    "t": "text",
                    "v": "Whether to hide his wealth or share it with the people."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q4",
          "number": 4,
          "points": 1,
          "skills": [
            "reference"
          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "In the last paragraph, the underlined word “this” refers to the fact that ________."
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "China was unified"
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "Qian fought to keep the kingdom"
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "Wuyue was divided into many parts"
                  }
                ]
              },
              {
                "id": "D",
                "content": [
                  {
                    "t": "text",
                    "v": "Qian handed over Wuyue to the Song"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q5",
          "number": 5,
          "points": 1,
          "skills": [
            "attitude",
            "inference"
          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "Which of the following statements would the author most likely agree with?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "Qian Hongchu put his people before his own power."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "Qian Hongchu cared more about his kingdom than about his people."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "Qian Hongchu believed fighting was the only way to achieve peace."
                  }
                ]
              },
              {
                "id": "D",
                "content": [
                  {
                    "t": "text",
                    "v": "Qian Hongchu failed to protect his kingdom because he was too weak."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q6",
          "number": 6,
          "points": 1,
          "skills": [
            "inference"
          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "Why does the author consider Qian’s choice the “bravest choice”?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "Because he chose to fight even though he knew he would lose."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "Because he put down his sword and let peace win, putting people first."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "Because he decided to run away and leave his kingdom."
                  }
                ]
              },
              {
                "id": "D",
                "content": [
                  {
                    "t": "text",
                    "v": "Because he chose wealth and honor over his people’s lives."
                  }
                ]
              }
            ]
          }
        }
      ]
    }
