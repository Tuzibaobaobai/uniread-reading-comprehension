                  {
                    "t": "text",
                    "v": "• The farther, the harder"
                  },
                  {
                    "t": "br"
                  },
                  {
                    "t": "text",
                    "v": "e.g. French: "
                  },
                  {
                    "t": "blank",
                    "id": "b5",
                    "number": 5
                  },
                  {
                    "t": "text",
                    "v": " vs. "
                  },
                  {
                    "t": "blank",
