                    "t": "blank",
                    "id": "b7",
                    "number": 7
                  },
                  {
                    "t": "text",
                    "v": " to learn Hindi than to learn Spanish."
                  },
                  {
                    "t": "br"
                  },
                  {
                    "t": "text",
                    "v": "• The mutual "
                  },
                  {
                    "t": "blank",
                    "id": "b8",
                    "number": 8
                  },
                  {
                    "t": "text",
                    "v": " of linguistic distance"
                  },
                  {
                    "t": "br"
                  },
                  {
                    "t": "text",
                    "v": "e.g. Chinese vs. English"
                  },
                  {
                    "t": "br"
                  },
                  {
                    "t": "text",
                    "v": "→ Chinese speakers will be "
                  },
                  {
                    "t": "blank",
