    "blocks": [
      {
        "id": "n1",
        "type": "note",
        "content": [
          [
            {
              "t": "text",
              "v": "Please use the "
            },
            {
              "t": "vocab",
              "v": "equipment",
              "ref": "v-equipment"
            },
            {
              "t": "text",
              "v": " in this gym in a safe and responsible way at all times and remember these points:"
            }
          ],
          [
            {
              "t": "text",
              "v": "★ "
            },
            {
              "t": "vocab",
              "v": "Appropriate",
              "ref": "v-appropriate"
            },
            {
              "t": "text",
              "v": " clothing and shoes for exercise should be worn."
            }
          ],
          [
            {
              "t": "text",
              "v": "★ Do not use any equipment if you are drunk."
            }
          ],
          [
            {
              "t": "text",
              "v": "★ No food or drinks (except water). No smoking."
            }
          ],
          [
            {
              "t": "text",
              "v": "★ Do not use the equipment shortly after having eaten."
            }
          ],
          [
            {
              "t": "text",
              "v": "★ Do not wear jewellery during your workouts."
            }
          ],
          [
            {
              "t": "text",
              "v": "★ Please follow any "
            },
            {
              "t": "vocab",
              "v": "instructions",
              "ref": "v-instruction"
            },
            {
              "t": "text",
              "v": " that are included with each piece of equipment."
            }
          ],
          [
            {
              "t": "text",
              "v": "★ Weight lifting should be done with a friend or trainer."
            }
          ],
          [
            {
              "t": "text",
              "v": "★ Do not lean on the equipment. Keep your hands away from any moving parts."
            }
          ],
          [
            {
              "t": "text",
              "v": "★ Please report faults to gym staff."
            }
          ],
          [
            {
              "t": "text",
              "v": "★ Carry a mobile phone when exercising to call for help in case of difficulty or "
            },
            {
              "t": "vocab",
              "v": "emergency",
              "ref": "v-emergency"
            },
            {
              "t": "text",
              "v": "."
            }
          ],
          [
            {
              "t": "text",
              "v": "★ Please return all equipment to its place and "
            },
            {
              "t": "vocab",
              "v": "wipe down",
              "ref": "v-wipe-down"
            },
            {
              "t": "text",
              "v": " equipment after use."
            }
          ],
          [
            {
              "t": "text",
              "v": "★ Children under 18 must be "
            },
            {
              "t": "vocab",
              "v": "accompanied",
              "ref": "v-accompany"
            },
            {
              "t": "text",
              "v": " by an adult."
            }
          ]
        ]
      }
    ]
  },
