  "title": "Meet the 19-Year-Old Lego Star",
  "titleZh": "遇见这位19岁的乐高之星",
  "displayName": "Week 1 Wednesday Meet the 19-Year-Old Lego Star",
  "taskType": {
    "code": "cloze",
    "labelZh": "完形填空"
  },
  "meta": {
    "genre": "新闻报道",
    "wordCount": 230,
