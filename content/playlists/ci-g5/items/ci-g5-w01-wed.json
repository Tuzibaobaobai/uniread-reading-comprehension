            "ref": "v-recycle"
          },
          {
            "t": "text",
            "v": "."
          }
        ]
      },
      {
        "id": "p3",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "Experts say plastic is bad for the "
          },
          {
            "t": "gloss",
            "v": "environment",
            "zh": "环境"
          },
          {
            "t": "text",
            "v": ". Plastic does not "
          },
          {
            "t": "vocab",
            "v": "disappear",
            "ref": "v-disappear"
          },
          {
            "t": "text",
            "v": " easily. It can "
          },
          {
            "t": "blank",
            "id": "b4",
            "number": 4
          },
          {
            "t": "text",
            "v": " in rivers, oceans and on beaches for many years. It can also "
          },
          {
            "t": "vocab",
            "v": "hurt",
            "ref": "v-hurt"
          },
          {
            "t": "text",
            "v": " animals and plants. "
          },
          {
            "t": "blank",
            "id": "b5",
            "number": 5
          },
          {
            "t": "text",
            "v": " plastic can make the air dirty."
          }
        ]
      },
      {
        "id": "p4",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "The survey also found that only a small amount of plastic is recycled. Many people think the best way to "
          },
          {
            "t": "vocab",
            "v": "protect",
            "ref": "v-protect"
          },
          {
            "t": "text",
            "v": " the Earth is to use "
          },
          {
            "t": "blank",
            "id": "b6",
            "number": 6
          },
          {
            "t": "text",
            "v": " plastic every day."
          }
        ]
      }
