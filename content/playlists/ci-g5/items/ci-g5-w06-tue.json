                  {
                    "t": "text",
                    "v": "They like warm places."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "They are attracted by carbon dioxide."
                  }
                ]
              },
              {
                "id": "C",
