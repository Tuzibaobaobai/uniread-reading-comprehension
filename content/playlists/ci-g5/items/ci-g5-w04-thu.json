            "v": "."
          }
        ]
      },
      {
        "id": "p5",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "There are more exciting things coming to her library. "
          },
          {
            "t": "blank",
            "id": "b4",
            "number": 4
          },
          {
            "t": "text",
            "v": " They will read the books out loud and "
          },
          {
            "t": "gloss",
            "v": "record",
            "zh": "录制"
          },
          {
            "t": "text",
            "v": " them. Other children can then listen to the books anytime."
          }
        ]
      },
      {
        "id": "p6",
        "type": "paragraph",
        "content": [
          {
            "t": "blank",
            "id": "b5",
            "number": 5
          },
          {
            "t": "text",
            "v": " Helping in the library gives her a chance to "
