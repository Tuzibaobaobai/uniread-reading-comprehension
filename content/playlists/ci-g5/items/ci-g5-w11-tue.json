          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "What happened around 1000 AD?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "People first wrote music in Babylonia."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "Guido d’Arezzo invented the musical stave."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "Italian became the only music language."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q4",
          "number": 4,
          "points": 1,
          "skills": [
            "detail"
          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "Which is TRUE according to the text?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "All music terms come from Italian."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "Italian is called “the language that sings”."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
