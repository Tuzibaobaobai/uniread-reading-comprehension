            "id": "b2",
            "number": 2
          },
          {
            "t": "text",
            "v": " together."
          }
        ]
      },
      {
        "id": "p2",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "A Tintin painting sold for €3.2 million. It became the most "
