          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "Why does a healthy person still need a vaccine?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "To get medicine."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "To help the body make antibodies."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "Because the doctor is not sure if you are healthy."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q2",
          "number": 2,
          "points": 1,
          "skills": [
            "detail"
          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "How many white blood cells are there inside our body?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "A few."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "A lot."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "None."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q3",
          "number": 3,
          "points": 1,
          "skills": [
            "detail"
          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "Which of the following are invaders in our body?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "Bacteria."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "Viruses."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "Both A and B."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q4",
          "number": 4,
          "points": 1,
          "skills": [
            "detail"
          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "What happens inside our body when we get a vaccine?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "We get sick because viruses enter our body."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "Our body can learn to fight dead or weakened viruses."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "White blood cells stop working."
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
