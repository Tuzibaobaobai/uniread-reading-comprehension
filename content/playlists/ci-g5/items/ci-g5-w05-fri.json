            "v": "terms",
            "ref": "v-term"
          }
        ]
      },
      {
        "id": "p2",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "Jazz "
          },
          {
            "t": "vocab",
            "v": "musicians",
            "ref": "v-musician"
          },
          {
            "t": "text",
            "v": " have their own words in their music. For example, “bread” is money; “cat” is a jazz musician; “jake” means okay. To “"
          },
          {
            "t": "gloss",
            "v": "dig",
            "zh": "挖掘"
          },
          {
            "t": "text",
            "v": "” is to know something; “hot plate” "
          },
          {
            "t": "vocab",
            "v": "stands for",
            "ref": "v-stand-for"
          },
          {
            "t": "text",
            "v": " a really good "
          },
          {
            "t": "vocab",
            "v": "recording",
            "ref": "v-recording"
          },
          {
            "t": "text",
            "v": ". Sounds like fun—you “dig” my meaning?"
          }
        ]
      },
      {
        "id": "h3",
        "type": "heading",
        "level": 3,
        "content": [
          {
            "t": "gloss",
            "v": "International Jazz Day",
            "zh": "国际爵士乐日"
          }
        ]
      },
      {
        "id": "p3",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "International Jazz Day takes place on April 30. Each year, one city is "
          },
          {
            "t": "gloss",
            "v": "selected",
            "zh": "选择"
          },
          {
            "t": "text",
            "v": " as the "
          },
          {
            "t": "gloss",
            "v": "Global Host City",
            "zh": "全球主办城市"
          },
          {
            "t": "text",
            "v": ". Top jazz musicians perform together. "
          },
          {
            "t": "vocab",
            "v": "Concerts",
            "ref": "v-concert"
          },
          {
            "t": "text",
            "v": " are held. People can listen to the "
          },
          {
            "t": "gloss",
            "v": "greats",
            "zh": "名家"
          },
          {
            "t": "text",
            "v": " of jazz music. You like jazz? Enjoy a "
          },
          {
            "t": "vocab",
            "v": "jazzy",
            "ref": "v-jazzy"
          },
          {
            "t": "text",
            "v": " day!"
          }
        ]
      },
      {
        "id": "i1",
        "type": "imageRef",
        "image": "img1"
      },
      {
        "id": "n1",
        "type": "note",
        "title": [
          {
            "t": "text",
            "v": "Did you know?"
          }
        ],
        "content": [
          [
            {
              "t": "text",
              "v": "* 欧洲古典音乐（European classical music），包括交响乐、管弦乐、歌剧、协奏曲、器乐独奏等。"
            }
          ],
          [
            {
              "t": "text",
              "v": "* 美国蓝调音乐（American blues），又称布鲁斯音乐，源于美国南部，节奏感强，缓慢忧郁。"
            }
          ],
          [
            {
              "t": "text",
              "v": "* 拉丁音乐（Latin music），源自拉丁美洲，节奏感强，适于跳舞。"
            }
          ],
          [
            {
              "t": "text",
              "v": "* 非洲音乐（African music），源自非洲，节奏感强，适于跳舞。"
            }
          ]
        ]
      }
    ]
