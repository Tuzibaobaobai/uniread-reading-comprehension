            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "Why were the hands of mechanical clocks made to move clockwise?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "To copy the way people write."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "To tell time more accurately"
                  },
                  {
                    "t": "gloss",
                    "v": "",
                    "zh": "精确地"
                  },
                  {
                    "t": "text",
                    "v": "."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "To follow the shadow movement on a sundial."
                  }
                ]
              }
            ]
          }
        }
