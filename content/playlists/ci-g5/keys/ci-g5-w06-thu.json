  "answers": {
    "q1": {
      "slots": {
        "b1": {
          "accept": [
            "inventor"
          ]
        }
      },
      "explanationZh": "the 和 of 中间要填名词，第一部分说 Nobel 发明了炸药，所以是 inventor（发明者）。",
      "evidence": [
        {
          "block": "p1",
          "quote": "He invented dynamite."
        }
      ]
    },
    "q2": {
      "slots": {
        "b2": {
          "accept": [
            "over"
          ]
        }
      },
      "explanationZh": "for over 120 years 是“超过120年”，奖从1901年发到现在。",
      "evidence": [
        {
          "block": "p3",
          "quote": "The Nobel Prizes were first awarded in 1901"
        }
      ]
    },
    "q3": {
      "slots": {
        "b3": {
          "accept": [
            "respected"
          ]
        }
      },
      "explanationZh": "原文说诺贝尔奖是世界上最受尊敬的奖项之一。",
      "evidence": [
        {
          "block": "p3",
          "quote": "They are one of the most respected awards in the world."
        }
      ]
    },
    "q4": {
      "slots": {
        "b4": {
          "accept": [
            "achievements"
          ]
        }
      },
      "explanationZh": "原文说奖给取得杰出成就的人，great 后面接名词 achievements。",
      "evidence": [
        {
          "block": "p4",
          "quote": "for outstanding"
        }
      ]
    },
    "q5": {
      "slots": {
        "b5": {
          "accept": [
            "fields"
          ]
        }
      },
      "explanationZh": "奖项分六个领域（fields）。",
      "evidence": [
        {
          "block": "p4",
          "quote": "in six"
        }
      ]
    },
    "q6": {
      "slots": {
        "b6": {
          "accept": [
            "Medicine",
            "medicine"
          ]
        }
      },
      "explanationZh": "这是奖项名称，直接抄原文 Physiology/Medicine。",
      "evidence": [
        {
          "block": "p4",
          "quote": "Physiology/Medicine"
        }
      ]
    },
    "q7": {
      "slots": {
        "b7": {
          "accept": [
            "Peace",
            "peace"
          ]
        }
      },
      "explanationZh": "六个奖项最后一个是 Peace（和平奖），抄原文。",
      "evidence": [
        {
          "block": "p4",
          "quote": "Economics and Peace"
        }
      ]
    },
