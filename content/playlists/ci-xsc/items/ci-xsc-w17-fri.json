    "blocks": [
      {
        "id": "p1",
        "type": "paragraph",
        "content": [
          { "t": "text", "v": "What’s it like to live and work in space? Here’s a day in the life of an " },
          { "t": "vocab", "v": "astronaut", "ref": "v-astronaut" },
          { "t": "text", "v": "." }
        ]
      },
      { "id": "h1", "type": "heading", "level": 3, "content": [{ "t": "text", "v": "Start of the day" }] },
      {
        "id": "p2",
        "type": "paragraph",
        "content": [
          { "t": "text", "v": "When astronauts wake up, they wash their faces and brush their teeth. But because of the " },
          { "t": "gloss", "v": "microgravity", "zh": "微重力" },
          { "t": "text", "v": " environment, they do these in a different way from us here on the ground. They use " },
          { "t": "gloss", "v": "face wipes", "zh": "面巾" },
          { "t": "text", "v": " and " },
          { "t": "vocab", "v": "squeeze", "ref": "v-squeeze" },
          { "t": "text", "v": " " },
          { "t": "vocab", "v": "toothpaste", "ref": "v-toothpaste" },
          { "t": "text", "v": " directly into their mouths. They can even eat their toothpaste!" }
        ]
      },
      { "id": "h2", "type": "heading", "level": 3, "content": [{ "t": "text", "v": "Work time" }] },
      {
        "id": "p3",
        "type": "paragraph",
        "content": [
          { "t": "text", "v": "Astronauts do science experiments in space. Like " },
          { "t": "gloss", "v": "homeowners", "zh": "房主" },
          { "t": "text", "v": ", they also do many things to keep their “home” " },
          { "t": "vocab", "v": "in good shape", "ref": "v-in-good-shape" },
          { "t": "text", "v": ", like checking support systems or cleaning " },
          { "t": "gloss", "v": "filters", "zh": "过滤器" },
          { "t": "text", "v": ". Sometimes they go out for a “spacewalk!”" }
        ]
      },
      { "id": "h3", "type": "heading", "level": 3, "content": [{ "t": "text", "v": "Three meals a day" }] },
      {
        "id": "p4",
        "type": "paragraph",
        "content": [
          { "t": "text", "v": "Astronauts eat breakfast, lunch and dinner every day. You know what? Chinese astronauts can choose from over 120 dishes! What’s on their menu? " },
          { "t": "gloss", "v": "Kung pao chicken", "zh": "宫保鸡丁" },
          { "t": "text", "v": ", " },
          { "t": "gloss", "v": "pickled", "zh": "腌渍的" },
          { "t": "text", "v": " cabbage, fresh fruit, tea, juice, soup, and more. They can also " },
          { "t": "vocab", "v": "heat", "ref": "v-heat" },
          { "t": "text", "v": " their food in a " },
          { "t": "vocab", "v": "microwave oven", "ref": "v-microwave-oven" },
          { "t": "text", "v": "." }
        ]
      },
      { "id": "h4", "type": "heading", "level": 3, "content": [{ "t": "text", "v": "A good night’s sleep" }] },
      {
        "id": "p5",
        "type": "paragraph",
        "content": [
          { "t": "text", "v": "Astronauts get a good night’s sleep in their sleeping bags. The sleeping bags are " },
          { "t": "vocab", "v": "attached to", "ref": "v-be-attached-to" },
          { "t": "text", "v": " the wall, so they won’t " },
          { "t": "vocab", "v": "float", "ref": "v-float" },
          { "t": "text", "v": " around all night." }
        ]
      }
    ],
    "vocabulary": [
      { "id": "v-astronaut", "headword": "astronaut", "ipa": "ˈæstrənɔːt", "pos": "n.", "meaningZh": "宇航员，航天员" },
      { "id": "v-squeeze", "headword": "squeeze", "ipa": "skwiːz", "pos": "v.", "meaningZh": "挤出" },
      { "id": "v-toothpaste", "headword": "toothpaste", "ipa": "ˈtuːθpeɪst", "pos": "n.", "meaningZh": "牙膏" },
      { "id": "v-heat", "headword": "heat", "ipa": "hiːt", "pos": "v.", "meaningZh": "加热" },
      { "id": "v-float", "headword": "float", "ipa": "fləʊt", "pos": "v.", "meaningZh": "飘动" },
      { "id": "v-in-good-shape", "headword": "in good shape", "meaningZh": "状态良好" },
