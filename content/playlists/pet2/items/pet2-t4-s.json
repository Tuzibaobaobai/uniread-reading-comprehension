            "prompt": [
              {
                "t": "text",
                "v": "Look at the photograph of people in an art class and talk about it on your own for about one minute."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "Now I’d like you to talk on your own about something. I’m going to give you a photograph and I’d like you to talk about it. Here is your photograph. It shows people in an art class. Please tell us what you can see in the photograph.",
                "audio": {
                  "src": "assets/pet2/pet2-t4-s-q2-t1.mp3",
                  "seconds": 17.5
                }
