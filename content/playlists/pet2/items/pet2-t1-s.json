            "prompt": [
              {
                "t": "text",
                "v": "Look at the photograph of friends enjoying time together and talk about it on your own for about one minute."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "Now I’d like you to talk on your own about something. I’m going to give you a photograph and I’d like you to talk about it. Here is your photograph. It shows friends enjoying time together. Please tell us what you can see in the photograph.",
                "audio": {
