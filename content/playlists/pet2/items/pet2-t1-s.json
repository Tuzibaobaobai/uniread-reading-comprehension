                  "seconds": 2
                }
              },
              {
                "id": "t3",
                "text": "Where do you live?",
                "audio": {
                  "src": "assets/pet2/pet2-t1-s-q1-t3.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t4",
                "text": "Who do you live with?",
                "audio": {
                  "src": "assets/pet2/pet2-t1-s-q1-t4.mp3",
                  "seconds": 2.1
                }
              },
              {
                "id": "t5",
                "text": "What subject do you find the easiest at school? (Why?)",
                "audio": {
                  "src": "assets/pet2/pet2-t1-s-q1-t5.mp3",
                  "seconds": 5
                }
              },
              {
                "id": "t6",
                "text": "What kind of music do you listen to?",
                "audio": {
                  "src": "assets/pet2/pet2-t1-s-q1-t6.mp3",
                  "seconds": 3
                }
              },
              {
                "id": "t7",
                "text": "What type of animals do you like?",
                "audio": {
                  "src": "assets/pet2/pet2-t1-s-q1-t7.mp3",
                  "seconds": 2.8
                }
              },
              {
                "id": "t8",
                "text": "Do you like shopping? (Why?/Why not?)",
                "audio": {
                  "src": "assets/pet2/pet2-t1-s-q1-t8.mp3",
                  "seconds": 4.2
                }
              },
              {
                "id": "t9",
                "text": "How often do you take photos? (Why?/Why not?)",
                "audio": {
                  "src": "assets/pet2/pet2-t1-s-q1-t9.mp3",
                  "seconds": 5.2
                }
              },
              {
                "id": "t10",
                "text": "Tell us about the kind of films you like.",
