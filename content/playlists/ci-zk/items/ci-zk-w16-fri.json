              {
                "t": "text",
                "v": "What is the advantage of using ENERGY STAR LED bulbs?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "It is easier to install ENERGY STAR LED bulbs than incandescent bulbs."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "An ENERGY STAR LED bulb lasts 15 hours longer than an incandescent bulb."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "Using ENERGY STAR LED bulbs helps you save about $900 a year on your electricity bill."
                  }
                ]
              },
              {
                "id": "D",
                "content": [
                  {
                    "t": "text",
                    "v": "An ENERGY STAR LED bulb uses only about 20% of the energy used by an incandescent bulb."
                  }
                ]
              }
            ]
          }
        }
