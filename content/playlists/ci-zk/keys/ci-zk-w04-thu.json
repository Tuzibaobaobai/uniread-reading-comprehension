  "officialRef": {
    "pdf": "中考第3辑初中时文阅读提分训练3+X第3辑中考答案.pdf",
    "pages": [
      10
    ]
  },
  "answers": {
    "q1": {
      "slots": {
        "b1": {
          "accept": [
            "expressing"
          ]
        }
      },
      "explanationZh": "have a hard time (in) doing sth. 是固定搭配，所以 express 要变成 expressing。",
      "evidence": [
        {
          "block": "p1",
          "quote": "have a hard time clearly "
        }
      ]
    },
    "q2": {
      "slots": {
        "b2": {
          "accept": [
            "in"
          ]
        }
      },
      "explanationZh": "说“二十多岁、三十多岁的人”要用 in one’s 20s and 30s，所以填 in。",
      "evidence": [
        {
          "block": "p2",
          "quote": "They asked 1,333 people, mostly "
        }
      ]
    },
    "q3": {
      "slots": {
        "b3": {
          "accept": [
            "those"
          ]
        }
      },
      "explanationZh": "those surveyed 指“那些被调查的人”，所以填 those。",
      "evidence": [
        {
          "block": "p2",
          "quote": "Among "
        }
      ]
    },
    "q4": {
      "slots": {
        "b4": {
          "accept": [
            "was caused"
          ]
        }
      },
      "explanationZh": "problem 和 cause 是被动关系，全文用过去时，所以填 was caused。",
      "evidence": [
        {
          "block": "p3",
          "quote": "Fifty-three per cent of people said the problem "
        }
      ]
    },
    "q5": {
      "slots": {
        "b5": {
          "accept": [
            "how"
          ]
        }
      },
      "explanationZh": "studied how young Chinese people talk online，意思是“研究他们怎样在网上交流”，填 how。",
      "evidence": [
        {
          "block": "p4",
          "quote": "studied "
        }
      ]
    },
    "q6": {
      "slots": {
        "b6": {
          "accept": [
            "Their",
            "their"
          ]
        }
      },
      "explanationZh": "空格后是名词 vocabulary，指年轻人的词汇，要用形容词性物主代词 Their（句首大写）。",
      "evidence": [
        {
          "block": "p4",
          "quote": " vocabulary hasn’t changed much"
        }
      ]
    },
    "q7": {
      "slots": {
        "b7": {
          "accept": [
            "has been"
          ]
        }
      },
      "explanationZh": "in recent years 常和现在完成时连用，主语 shiyu 是单数，所以填 has been。",
      "evidence": [
        {
          "block": "p5",
          "quote": "a hot topic in recent years"
        }
      ]
    },
    "q8": {
      "slots": {
        "b8": {
          "accept": [
            "for"
          ]
        }
      },
      "explanationZh": "ask for advice 是固定搭配，意思是“寻求建议”，填 for。",
      "evidence": [
        {
          "block": "p5",
          "quote": "more than 380,000 Douban users have joined a group to ask "
        }
      ]
    },
    "q9": {
      "slots": {
        "b9": {
          "accept": [
            "reading"
          ]
        }
      },
      "explanationZh": "动词不能直接做主语，要变成动名词 reading，reading more books 是主语。",
      "evidence": [
        {
          "block": "p6",
          "quote": "According to the survey, 58.4% believed "
        }
      ]
    },
    "q10": {
      "slots": {
        "b10": {
          "accept": [
            "to practise"
          ]
        }
      },
      "explanationZh": "chances to do sth. 表示“做某事的机会”，所以填 to practise。",
      "evidence": [
        {
          "block": "p6",
          "quote": "this could give them more chances "
        }
      ]
    }
  }
}