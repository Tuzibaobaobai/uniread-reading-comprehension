            "t": "vocab",
            "v": "lie down",
            "ref": "v-liedown"
          },
          {
            "t": "text",
            "v": " to sleep like "
          },
          {
            "t": "vocab",
            "v": "humans",
            "ref": "v-human"
          },
          {
            "t": "text",
            "v": ". That could be "
          },
          {
            "t": "blank",
            "id": "b2",
            "number": 2
          },
          {
            "t": "text",
            "v": ". Only part of their "
          },
          {
            "t": "gloss",
            "v": "brain",
            "zh": "大脑"
          },
          {
            "t": "text",
            "v": " sleeps "
          },
          {
            "t": "vocab",
            "v": "at a time",
            "ref": "v-atatime"
          },
          {
            "t": "text",
            "v": ", so they do rest, but they are never "
          },
          {
            "t": "gloss",
            "v": "completely",
            "zh": "完全地"
          },
          {
            "t": "text",
            "v": " asleep. Some fish, such as "
          },
          {
            "t": "vocab",
            "v": "sharks",
            "ref": "v-shark"
          },
          {
            "t": "text",
            "v": ", even "
          },
          {
            "t": "gloss",
            "v": "continue",
            "zh": "继续"
          },
          {
            "t": "text",
            "v": " "
          },
          {
            "t": "blank",
            "id": "b3",
            "number": 3
          },
          {
            "t": "text",
            "v": " in their sleep."
          }
        ]
      },
      {
        "id": "h3",
        "type": "heading",
        "content": [
