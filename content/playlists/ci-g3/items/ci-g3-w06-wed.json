            "ref": "v-adult"
          },
          {
            "t": "text",
            "v": " "
          },
          {
            "t": "blank",
            "id": "b3",
            "number": 3
          },
          {
            "t": "text",
            "v": " the day together. People in "
          },
          {
            "t": "gloss",
            "v": "Nepal",
            "zh": "尼泊尔"
          },
          {
            "t": "text",
            "v": ", Australia, the UK, and the US also "
          },
          {
            "t": "blank",
            "id": "b4",
            "number": 4
          },
          {
            "t": "text",
            "v": " Holi."
          }
        ]
      },
