            "t": "blank",
            "id": "b1",
            "number": 1
          },
          {
            "t": "text",
            "v": " wins over the dark."
          }
        ]
      },
      {
        "id": "p2",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "During Holi, people throw coloured "
