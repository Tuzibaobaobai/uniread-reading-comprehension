        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "Do you like visiting "
          },
          {
            "t": "vocab",
            "v": "museums",
            "ref": "v-museum"
          },
          {
            "t": "text",
            "v": "? "
          },
          {
            "t": "blank",
            "id": "b1",
            "number": 1
          },
          {
            "t": "text",
            "v": " But have you thought of "
