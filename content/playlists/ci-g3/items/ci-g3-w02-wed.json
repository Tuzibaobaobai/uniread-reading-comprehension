            "zh": "长途远行"
          },
          {
            "t": "text",
            "v": " to see doctors. Because of this, more people need "
          },
          {
            "t": "blank",
            "id": "b5",
            "number": 5
          },
          {
            "t": "text",
            "v": " at hospitals."
          }
        ]
      },
      {
        "id": "p4",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "Patient companions are becoming "
