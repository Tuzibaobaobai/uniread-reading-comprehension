            "number": 1
          },
          {
            "t": "text",
            "v": "! The Sixth TOPS Pet Expo in Shanghai was "
          },
          {
            "t": "blank",
            "id": "b2",
            "number": 2
          },
          {
            "t": "text",
            "v": "—over 8,000 brands "
