            "prompt": [{ "t": "text", "v": "What are the “artificial embryos” made from?" }],
            "options": [
              { "id": "A", "content": [{ "t": "text", "v": "Stem cells." }] },
              { "id": "B", "content": [{ "t": "text", "v": "Real babies." }] },
              { "id": "C", "content": [{ "t": "text", "v": "Animal eggs." }] }
            ]
          }
        },
        {
          "id": "q2",
          "number": 2,
          "points": 1,
          "skills": ["detail"],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [{ "t": "text", "v": "Why are scientists doing the experiment in space?" }],
            "options": [
              { "id": "A", "content": [{ "t": "text", "v": "To grow real humans in space." }] },
              { "id": "B", "content": [{ "t": "text", "v": "To study how early human cells grow in space." }] },
              { "id": "C", "content": [{ "t": "text", "v": "To send more liquid to the space station." }] }
            ]
          }
        },
        {
          "id": "q3",
          "number": 3,
          "points": 1,
          "skills": ["detail"],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [{ "t": "text", "v": "What will happen to the samples after five days?" }],
            "options": [
              { "id": "A", "content": [{ "t": "text", "v": "They will return to Earth for more study." }] },
              { "id": "B", "content": [{ "t": "text", "v": "They will stay on the space station forever." }] },
              { "id": "C", "content": [{ "t": "text", "v": "They will be used in another experiment on the Moon." }] }
            ]
          }
        }
      ]
