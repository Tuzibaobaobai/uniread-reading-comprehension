    "blocks": [
      {
        "id": "p1",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "Cemal Senturk comes from "
          },
          {
            "t": "gloss",
            "v": "Türkiye",
            "zh": "土耳其"
          },
          {
            "t": "text",
            "v": ". He has a dog. His dog’s name is Boncuk. Senturk and Boncuk are best friends."
          }
        ]
      },
      {
        "id": "p2",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "Senturk must go to the "
          },
          {
            "t": "vocab",
            "v": "hospital",
            "ref": "v-hospital"
          },
          {
            "t": "text",
            "v": ". An "
          },
          {
            "t": "vocab",
            "v": "ambulance",
            "ref": "v-ambulance"
          },
          {
            "t": "text",
            "v": " takes him there. His dog runs after the ambulance. It "
          },
          {
            "t": "vocab",
            "v": "waits",
            "ref": "v-wait"
          },
          {
            "t": "text",
            "v": " in front of the hospital. It sits there for three days."
          }
        ]
      },
      {
        "id": "p3",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "Senturk’s daughter takes the dog home. The dog "
          },
          {
            "t": "vocab",
            "v": "returns",
            "ref": "v-return"
          },
          {
            "t": "text",
            "v": " to the hospital. Senturk’s daughter takes the dog home again. The dog returns to the hospital again."
          }
        ]
      },
      {
        "id": "p4",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "Senturk leaves the hospital after six days. He meets his dog. They are both very happy. Senturk says that a dog can be a best friend. Dogs bring "
          },
          {
            "t": "vocab",
            "v": "joy",
            "ref": "v-joy"
          },
          {
            "t": "text",
            "v": ". They make people happy."
          }
        ]
      }
    ]
