  "sections": [
    {
      "id": "s1",
      "part": 1,
      "label": "Part 1",
      "instruction": "Answer the examiner’s questions.",
      "questions": [
        {
          "id": "q1",
          "number": 1,
          "points": 20,
          "skills": [],
          "interaction": {
            "kind": "speaking",
            "prompt": [
              {
                "t": "text",
                "v": "Answer the examiner’s questions about yourself and your everyday life."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "What’s your name?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q1-t1.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t2",
                "text": "How old are you?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q1-t2.mp3",
                  "seconds": 2
                }
              },
              {
                "id": "t3",
                "text": "Where do you live?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q1-t3.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t4",
                "text": "Who do you live with?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q1-t4.mp3",
                  "seconds": 2.1
                }
              },
              {
                "id": "t5",
                "text": "How often do you use a mobile phone? Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q1-t5.mp3",
                  "seconds": 4.5
                }
              },
              {
                "id": "t6",
                "text": "What is your favourite time of day? Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q1-t6.mp3",
                  "seconds": 4
                }
              },
              {
                "id": "t7",
                "text": "Tell us about something you’d like to do in the future. Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q1-t7.mp3",
                  "seconds": 4.9
                }
              },
              {
                "id": "t8",
                "text": "What type of music do you like listening to? Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q1-t8.mp3",
                  "seconds": 4.8
                }
              },
              {
                "id": "t9",
                "text": "Do you enjoy shopping? Why? / Why not?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q1-t9.mp3",
                  "seconds": 4.3
                }
              },
              {
                "id": "t10",
                "text": "Tell us about something you’d like to study in the future. Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q1-t10.mp3",
                  "seconds": 5
                }
              },
              {
                "id": "t11",
                "text": "What type of programmes do you like watching on television? Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q1-t11.mp3",
                  "seconds": 5.3
                }
              },
              {
                "id": "t12",
                "text": "What kind of things do you like reading? Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q1-t12.mp3",
                  "seconds": 4
                }
              }
            ],
            "maxSeconds": 30,
            "scoring": "judge"
          }
        }
      ]
    },
    {
      "id": "s2",
      "part": 2,
      "label": "Part 2",
      "instruction": "Talk about your photograph on your own.",
      "questions": [
        {
          "id": "q2",
          "number": 2,
          "points": 20,
          "skills": [],
          "material": [
            {
              "id": "i1",
              "type": "imageRef",
              "image": "img1"
            }
          ],
          "interaction": {
            "kind": "speaking",
            "prompt": [
              {
                "t": "text",
                "v": "Look at the photograph of a family spending time together and talk about it on your own for about one minute."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "Now I’d like you to talk on your own about something. I’m going to give you a photograph and I’d like you to talk about it. Here is your photograph. It shows a family spending time together. Please tell us what you can see in the photograph.",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q2-t1.mp3",
                  "seconds": 18.3
                }
              }
            ],
            "maxSeconds": 75,
            "scoring": "judge"
          }
        }
      ]
    },
    {
      "id": "s3",
      "part": 3,
      "label": "Part 3",
      "instruction": "Talk together with your partner about the situation.",
      "questions": [
        {
          "id": "q3",
          "number": 3,
          "points": 20,
          "skills": [],
          "material": [
            {
              "id": "i2",
              "type": "imageRef",
              "image": "img2"
            }
          ],
          "interaction": {
            "kind": "speaking",
            "prompt": [
              {
                "t": "text",
                "v": "Talk with your partner about the souvenirs a girl could choose to remember her seaside holiday, and decide which would be best."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "Now, in this part of the test you’re going to talk about something together for about two minutes. I’m going to describe a situation to you. A girl has been on holiday with her family at the seaside. She wants to choose a souvenir which will help her remember the holiday every time she uses it. Here are some souvenirs she could choose. Talk together about the different souvenirs she could choose and say which would be best. All right? Now, talk together.",
                "role": "examiner",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q3-t1.mp3",
                  "seconds": 33.3
                }
              },
              {
                "id": "t2",
                "text": "Shall I start? I think the sunglasses are a good idea, because she can wear them every summer and remember the beach. What do you think?",
                "role": "partner",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q3-t2.mp3",
                  "seconds": 9
                }
              },
              {
                "id": "t3",
                "text": "What about the earrings? They look like little boats. But maybe she won’t wear them very often. Do you agree?",
                "role": "partner",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q3-t3.mp3",
                  "seconds": 6.9
                }
              },
              {
                "id": "t4",
                "text": "I’m not sure about the chocolates. They’re nice, but she’ll eat them quickly and then they’re gone. What’s your opinion?",
                "role": "partner",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q3-t4.mp3",
                  "seconds": 7.7
                }
              },
              {
                "id": "t5",
                "text": "The watch has a whale on it. She can use it every day, so she’ll often remember the holiday. Do you like that idea?",
                "role": "partner",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q3-t5.mp3",
                  "seconds": 7.7
                }
              },
              {
                "id": "t6",
                "text": "And what about the teddy bear and the little surfboard? Are they useful, do you think?",
                "role": "partner",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q3-t6.mp3",
                  "seconds": 5.4
                }
              },
              {
                "id": "t7",
                "text": "So, which souvenir do you think would be best? I think the watch, because she’ll use it every day. Shall we choose that?",
                "role": "partner",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q3-t7.mp3",
                  "seconds": 7.9
                }
              }
            ],
            "maxSeconds": 45,
            "scoring": "judge"
          }
        }
      ]
    },
    {
      "id": "s4",
      "part": 4,
      "label": "Part 4",
      "instruction": "Answer the examiner’s questions about the topic of Part 3.",
      "questions": [
        {
          "id": "q4",
          "number": 4,
          "points": 20,
          "skills": [],
          "interaction": {
            "kind": "speaking",
            "prompt": [
              {
                "t": "text",
                "v": "Answer the examiner’s questions about holidays, souvenirs and the seaside."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "Have you ever brought a souvenir home from a holiday? What was it?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q4-t1.mp3",
                  "seconds": 5.7
                }
              },
              {
                "id": "t2",
                "text": "When was the last time you went to the beach? Was the weather good?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q4-t2.mp3",
                  "seconds": 5.1
                }
              },
              {
                "id": "t3",
                "text": "Would you like to live by the sea? Why? / Why not?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q4-t3.mp3",
                  "seconds": 5.1
                }
              },
              {
                "id": "t4",
                "text": "Is it important for everybody to learn to swim? Why? / Why not?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q4-t4.mp3",
                  "seconds": 5.8
                }
              },
              {
                "id": "t5",
                "text": "Is the beach the best place to go on holiday? Why? / Why not?",
                "audio": {
                  "src": "assets/pet3/pet3-t1-s-q4-t5.mp3",
                  "seconds": 6.1
                }
              }
            ],
            "maxSeconds": 40,
            "scoring": "judge"
          }
        }
      ]
    }
