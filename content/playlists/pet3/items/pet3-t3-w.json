                  {
                    "t": "callout",
                    "v": "Tell Mr Burton"
                  }
                ],
                [
                  {
                    "t": "text",
                    "v": "I’m having a meeting about Healthy Living Day after school this Tuesday. Can you come?"
                  },
                  {
                    "t": "callout",
                    "v": "Sorry, but…"
                  }
