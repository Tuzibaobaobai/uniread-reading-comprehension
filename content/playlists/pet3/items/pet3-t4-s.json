      "id": "s1",
      "part": 1,
      "label": "Part 1",
      "instruction": "Answer the examiner’s questions.",
      "questions": [
        {
          "id": "q1",
          "number": 1,
          "points": 20,
          "skills": [],
          "interaction": {
            "kind": "speaking",
            "prompt": [
              {
                "t": "text",
                "v": "Answer the examiner’s questions about yourself and your everyday life."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "What’s your name?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q1-t1.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t2",
                "text": "How old are you?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q1-t2.mp3",
                  "seconds": 2
                }
              },
              {
                "id": "t3",
                "text": "Where do you live?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q1-t3.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t4",
                "text": "Who do you live with?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q1-t4.mp3",
                  "seconds": 2.1
                }
              },
              {
                "id": "t5",
                "text": "How often do you use a mobile phone? Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q1-t5.mp3",
                  "seconds": 4.5
                }
              },
              {
                "id": "t6",
                "text": "What is your favourite time of day? Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q1-t6.mp3",
                  "seconds": 4
                }
              },
              {
                "id": "t7",
                "text": "Tell us about something you’d like to do in the future. Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q1-t7.mp3",
                  "seconds": 4.9
                }
              },
              {
                "id": "t8",
                "text": "What type of music do you like listening to? Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q1-t8.mp3",
                  "seconds": 4.8
                }
              },
              {
                "id": "t9",
                "text": "Do you enjoy shopping? Why? / Why not?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q1-t9.mp3",
                  "seconds": 4.4
                }
              },
              {
                "id": "t10",
                "text": "Tell us about something you’d like to study in the future. Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q1-t10.mp3",
                  "seconds": 5
                }
              },
              {
                "id": "t11",
                "text": "What type of programmes do you like watching on television? Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q1-t11.mp3",
                  "seconds": 5.4
                }
              },
              {
                "id": "t12",
                "text": "What kind of things do you like reading? Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q1-t12.mp3",
                  "seconds": 4
                }
              }
            ],
            "maxSeconds": 30,
            "scoring": "judge"
          }
        }
      ]
    },
    {
      "id": "s2",
      "part": 2,
      "label": "Part 2",
      "instruction": "Talk about your photograph on your own.",
      "questions": [
        {
          "id": "q2",
          "number": 2,
          "points": 20,
          "skills": [],
          "material": [
            {
              "id": "i1",
              "type": "imageRef",
              "image": "img1"
            }
          ],
          "interaction": {
            "kind": "speaking",
            "prompt": [
              {
                "t": "text",
                "v": "Look at the photograph of people in the kitchen and talk about it on your own for about one minute."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "Now I’d like you to talk on your own about something. I’m going to give you a photograph and I’d like you to talk about it. Here is your photograph. It shows people in the kitchen. Please tell us what you can see in the photograph.",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q2-t1.mp3",
                  "seconds": 17.4
                }
              }
            ],
            "maxSeconds": 75,
            "scoring": "judge"
          }
        }
      ]
    },
    {
      "id": "s3",
      "part": 3,
      "label": "Part 3",
      "instruction": "Talk together with your partner about the situation.",
      "questions": [
        {
          "id": "q3",
          "number": 3,
          "points": 20,
          "skills": [],
          "material": [
            {
              "id": "i2",
              "type": "imageRef",
              "image": "img2"
            }
          ],
          "interaction": {
            "kind": "speaking",
            "prompt": [
              {
                "t": "text",
                "v": "Talk with your partner about the prizes a music teacher could give to the winner of a school music competition, and decide which would be best."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "Now, in this part of the test you’re going to talk about something together for about two minutes. I’m going to describe a situation to you. A music teacher is organising a competition for the best singer or musician in the school. She wants to give a prize to the winner of the competition. Here are some prizes she could give. Talk together about the different prizes she could give to the winner of the competition, and say which would be best. All right? Now, talk together.",
                "role": "examiner",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q3-t1.mp3",
                  "seconds": 33.7
                }
              },
              {
                "id": "t2",
                "text": "Shall I start? I think the flute is a good prize, because the winner can use it to make more music. What do you think?",
                "role": "partner",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q3-t2.mp3",
                  "seconds": 7.2
                }
              },
              {
                "id": "t3",
                "text": "But maybe the winner already has an instrument, or plays a different one. What about the tickets for a show? Do you like that idea?",
                "role": "partner",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q3-t3.mp3",
                  "seconds": 7.8
                }
              },
              {
                "id": "t4",
                "text": "I’m not sure about the flowers. They’re nice, but they don’t last very long. Do you agree?",
                "role": "partner",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q3-t4.mp3",
                  "seconds": 6.3
                }
              },
              {
                "id": "t5",
                "text": "The hoodie has music notes on it, so it’s a good reminder of the competition. Would you like to win a hoodie?",
                "role": "partner",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q3-t5.mp3",
                  "seconds": 6.2
                }
              },
              {
                "id": "t6",
                "text": "And what about the watch or the CDs? Which one do you think is more useful?",
                "role": "partner",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q3-t6.mp3",
                  "seconds": 5.1
                }
              },
              {
                "id": "t7",
                "text": "So, which prize do you think would be best? I think the tickets, because it’s a special day out. Shall we choose them?",
                "role": "partner",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q3-t7.mp3",
                  "seconds": 7.5
                }
              }
            ],
            "maxSeconds": 45,
            "scoring": "judge"
          }
        }
      ]
    },
    {
      "id": "s4",
      "part": 4,
      "label": "Part 4",
      "instruction": "Answer the examiner’s questions about the topic of Part 3.",
      "questions": [
        {
          "id": "q4",
          "number": 4,
          "points": 20,
          "skills": [],
          "interaction": {
            "kind": "speaking",
            "prompt": [
              {
                "t": "text",
                "v": "Answer the examiner’s questions about competitions, concerts and music."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "Have you ever entered a competition? What was the competition?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q4-t1.mp3",
                  "seconds": 4.8
                }
              },
              {
                "id": "t2",
                "text": "Have you ever been to a concert? Did you enjoy it? / Would you like to go to one?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q4-t2.mp3",
                  "seconds": 6
                }
              },
              {
                "id": "t3",
                "text": "Are you learning to play a musical instrument? Is it difficult to learn? / Would you like to learn to play one? Why? / Why not?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q4-t3.mp3",
                  "seconds": 9.8
                }
              },
              {
                "id": "t4",
                "text": "Do you prefer listening to music when you’re happy or when you’re sad? Why?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q4-t4.mp3",
                  "seconds": 6.5
                }
              },
              {
                "id": "t5",
                "text": "Is it important for a film to have good music? Why? / Why not?",
                "audio": {
                  "src": "assets/pet3/pet3-t4-s-q4-t5.mp3",
                  "seconds": 5.6
                }
              }
            ],
            "maxSeconds": 40,
            "scoring": "judge"
          }
        }
      ]
    }
