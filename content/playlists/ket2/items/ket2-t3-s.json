          "interaction": {
            "kind": "speaking",
            "prompt": [
              {
                "t": "text",
                "v": "Answer the examiner’s questions about yourself, photos and food."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "What’s your name?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q1-t1.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t2",
                "text": "How old are you?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q1-t2.mp3",
                  "seconds": 2
                }
              },
              {
                "id": "t3",
                "text": "Where do you live?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q1-t3.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t4",
                "text": "Now, let’s talk about photos. How often do you take photos?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q1-t4.mp3",
                  "seconds": 5.2
                }
              },
              {
                "id": "t5",
                "text": "Who do you share your photos with?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q1-t5.mp3",
                  "seconds": 2.8
                }
              },
              {
                "id": "t6",
                "text": "Now, please tell me something about a good photo you have taken.",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q1-t6.mp3",
                  "seconds": 4.6
                }
              },
              {
                "id": "t7",
                "text": "Now, let’s talk about food. What do you usually eat for breakfast?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q1-t7.mp3",
                  "seconds": 5.9
                }
              },
              {
                "id": "t8",
                "text": "Which is your favourite fruit?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q1-t8.mp3",
                  "seconds": 2.5
                }
              }
            ],
            "maxSeconds": 30,
            "scoring": "judge"
          }
        }
      ]
    },
    {
      "id": "s2",
      "part": 2,
      "label": "Part 2",
      "instruction": "Look at the pictures and talk about them with your partner. Then answer the examiner’s questions.",
      "questions": [
        {
          "id": "q2",
          "number": 2,
          "points": 15,
          "skills": [],
          "material": [
            {
              "id": "i1",
              "type": "imageRef",
              "image": "img1"
            }
          ],
          "interaction": {
            "kind": "speaking",
            "prompt": [
              {
                "t": "text",
                "v": "Look at the pictures of different things to read. Talk about them with your partner: say if you like them and why or why not. Then answer the examiner’s questions."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "Here are some pictures that show different things to read. Do you like these different things to read? Say why or why not.",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t1.mp3",
                  "seconds": 9.3
                }
              },
              {
                "id": "t10",
                "text": "I love reading comics. The pictures are great and the stories are funny. Do you like comics?",
                "role": "partner",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t10.mp3",
                  "seconds": 6.9
                }
              },
              {
                "id": "t11",
                "text": "I read text messages from my friends every day. It’s fun. Do you like reading text messages?",
                "role": "partner",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t11.mp3",
                  "seconds": 6.5
                }
              },
              {
                "id": "t12",
                "text": "I don’t read newspapers. They’re a bit boring for me. What about you?",
                "role": "partner",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t12.mp3",
                  "seconds": 4.9
                }
              },
              {
                "id": "t13",
                "text": "My mum uses cook books a lot, but I never cook. Do you like cook books?",
                "role": "partner",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t13.mp3",
                  "seconds": 5.6
                }
              },
              {
                "id": "t2",
                "text": "Do you think reading newspapers is a good idea? Why? / Why not?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t2.mp3",
                  "seconds": 5.8
                }
              },
              {
                "id": "t3",
                "text": "Do you think reading comics is easy? Why? / Why not?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t3.mp3",
                  "seconds": 5.3
                }
              },
              {
                "id": "t4",
                "text": "Do you think reading text messages is fun? Why? / Why not?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t4.mp3",
                  "seconds": 5.9
                }
              },
              {
                "id": "t5",
                "text": "Do you think reading cook books is useful? Why? / Why not?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t5.mp3",
                  "seconds": 5.3
                }
              },
              {
                "id": "t6",
                "text": "Do you think reading maps is difficult? Why? / Why not?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t6.mp3",
                  "seconds": 5.2
                }
              },
              {
                "id": "t7",
                "text": "So, which of these things to read do you like best?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t7.mp3",
                  "seconds": 4.9
                }
              },
              {
                "id": "t8",
                "text": "Now, do you prefer reading a book or watching a film? Why?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t8.mp3",
                  "seconds": 6
                }
              },
              {
                "id": "t9",
                "text": "What’s the best book you’ve ever read? Why?",
                "audio": {
                  "src": "assets/ket2/ket2-t3-s-q2-t9.mp3",
                  "seconds": 4.2
                }
              }
            ],
            "maxSeconds": 45,
            "scoring": "judge"
          }
        }
      ]
