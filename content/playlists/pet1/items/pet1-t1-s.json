                  "seconds": 5.4
                }
              },
              {
                "id": "t2",
                "text": "Do you walk to school? Why? / Why not?",
                "audio": {
                  "src": "assets/pet1/pet1-t1-s-q4-t2.mp3",
                  "seconds": 4.3
                }
              },
              {
                "id": "t3",
                "text": "When was the last time you went for a really long walk? Where did you go?",
                "audio": {
                  "src": "assets/pet1/pet1-t1-s-q4-t3.mp3",
                  "seconds": 5.7
                }
              },
              {
                "id": "t4",
                "text": "Which outdoor activity do you enjoy doing most? Why?",
                "audio": {
                  "src": "assets/pet1/pet1-t1-s-q4-t4.mp3",
                  "seconds": 5
                }
              },
              {
                "id": "t5",
                "text": "Is it important for young people to spend time outdoors? Why? / Why not?",
                "audio": {
                  "src": "assets/pet1/pet1-t1-s-q4-t5.mp3",
                  "seconds": 6.6
                }
              }
            ],
            "maxSeconds": 40,
            "scoring": "judge"
          }
        }
