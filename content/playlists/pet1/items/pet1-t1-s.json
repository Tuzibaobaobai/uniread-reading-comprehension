            "prompt": [
              {
                "t": "text",
                "v": "Look at the photograph of someone watching TV and talk about it on your own for about one minute."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "Now I’d like you to talk on your own about something. I’m going to give you a photograph and I’d like you to talk about it. Here is your photograph. It shows someone watching TV. Please tell us what you can see in the photograph.",
                "audio": {
                  "src": "assets/pet1/pet1-t1-s-q2-t1.mp3",
                  "seconds": 17.4
                }
              }
            ],
            "maxSeconds": 75,
