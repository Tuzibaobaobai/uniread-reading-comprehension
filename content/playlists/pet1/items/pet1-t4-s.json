                  "src": "assets/pet1/pet1-t4-s-q4-t1.mp3",
                  "seconds": 5.6
                }
              },
              {
                "id": "t2",
                "text": "What’s your favourite way to travel on a long journey? Why?",
                "audio": {
                  "src": "assets/pet1/pet1-t4-s-q4-t2.mp3",
                  "seconds": 5.4
                }
              },
              {
                "id": "t3",
                "text": "Where would you most like to travel to in the future? Why?",
                "audio": {
                  "src": "assets/pet1/pet1-t4-s-q4-t3.mp3",
                  "seconds": 4.9
                }
              },
              {
                "id": "t4",
                "text": "What’s the best place you’ve visited in your country? Why?",
                "audio": {
                  "src": "assets/pet1/pet1-t4-s-q4-t4.mp3",
                  "seconds": 4.8
                }
              },
              {
                "id": "t5",
                "text": "Is it better to have a holiday in your own country or to go abroad? Why?",
                "audio": {
                  "src": "assets/pet1/pet1-t4-s-q4-t5.mp3",
                  "seconds": 6.3
                }
              }
            ],
            "maxSeconds": 40,
            "scoring": "judge"
          }
        }
      ]
