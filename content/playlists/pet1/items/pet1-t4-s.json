    {
      "id": "s2",
      "part": 2,
      "label": "Part 2",
      "instruction": "Talk about your photograph on your own.",
      "questions": [
        {
          "id": "q2",
          "number": 2,
          "points": 20,
          "skills": [],
          "material": [
            {
              "id": "i1",
