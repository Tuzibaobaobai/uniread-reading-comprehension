          "interaction": {
            "kind": "speaking",
            "prompt": [
              {
                "t": "text",
                "v": "Answer the examiner’s questions about yourself and your everyday life."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "What’s your name?",
                "audio": {
                  "src": "assets/pet1/pet1-t2-s-q1-t1.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t2",
                "text": "How old are you?",
                "audio": {
                  "src": "assets/pet1/pet1-t2-s-q1-t2.mp3",
                  "seconds": 2
                }
              },
              {
                "id": "t3",
                "text": "Where do you live?",
                "audio": {
                  "src": "assets/pet1/pet1-t2-s-q1-t3.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t4",
                "text": "Who do you live with?",
                "audio": {
                  "src": "assets/pet1/pet1-t2-s-q1-t4.mp3",
                  "seconds": 2.1
                }
              },
              {
                "id": "t5",
                "text": "Tell us about a teacher you like.",
                "audio": {
                  "src": "assets/pet1/pet1-t2-s-q1-t5.mp3",
                  "seconds": 3
                }
              },
              {
                "id": "t6",
                "text": "How often do you use a mobile phone?",
                "audio": {
                  "src": "assets/pet1/pet1-t2-s-q1-t6.mp3",
                  "seconds": 3.4
                }
              },
              {
                "id": "t7",
                "text": "Which time of year do you like the most? Why?",
                "audio": {
                  "src": "assets/pet1/pet1-t2-s-q1-t7.mp3",
                  "seconds": 4.3
                }
              },
              {
                "id": "t8",
                "text": "Which do you like best, the morning or the afternoon? Why?",
                "audio": {
                  "src": "assets/pet1/pet1-t2-s-q1-t8.mp3",
                  "seconds": 5.5
                }
              },
              {
                "id": "t9",
                "text": "Tell us about sports you like.",
                "audio": {
                  "src": "assets/pet1/pet1-t2-s-q1-t9.mp3",
                  "seconds": 2.9
                }
              },
              {
                "id": "t10",
                "text": "What type of music do you like listening to?",
                "audio": {
                  "src": "assets/pet1/pet1-t2-s-q1-t10.mp3",
                  "seconds": 3.6
                }
              },
              {
                "id": "t11",
                "text": "Tell us what you do in the school holidays.",
                "audio": {
                  "src": "assets/pet1/pet1-t2-s-q1-t11.mp3",
                  "seconds": 3.6
                }
              },
              {
                "id": "t12",
                "text": "What new hobby would you like to try? Why?",
                "audio": {
                  "src": "assets/pet1/pet1-t2-s-q1-t12.mp3",
                  "seconds": 4.1
                }
              }
            ],
            "maxSeconds": 30,
