                  "seconds": 4.3
                }
              },
              {
                "id": "t3",
                "text": "Have you ever tried to make your own clothes? Why? / Why not?",
                "audio": {
                  "src": "assets/pet1/pet1-t3-s-q4-t3.mp3",
