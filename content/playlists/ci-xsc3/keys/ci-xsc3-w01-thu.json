  "answers": {
    "q1": {
      "slots": {
        "b1": {
          "accept": [
            "longer"
          ]
        }
      },
      "explanationZh": "no longer 是固定搭配，意思是“不再”。海南到 2030 年不再卖燃油车。",
      "evidence": [
        {
          "block": "p1",
          "quote": "Hainan Island will no"
        }
      ]
    },
    "q2": {
      "slots": {
        "b2": {
          "accept": [
            "aims"
          ]
        }
      },
      "explanationZh": "主语 The plan 是第三人称单数，讲的是事实，用一般现在时，所以 aim 要加 s。",
      "evidence": [
        {
          "block": "p2",
          "quote": "The plan"
        }
      ],
      "tipsZh": "aim to do sth. 旨在做某事"
    },
    "q3": {
      "slots": {
        "b3": {
          "accept": [
            "first"
          ]
        }
      },
      "explanationZh": "空前有 the，后面是 province，要用序数词。“第一个”这样做的省份，填 first。",
      "evidence": [
        {
          "block": "p2",
          "quote": "It makes Hainan the"
        }
      ]
    },
    "q4": {
      "slots": {
        "b4": {
          "accept": [
            "natural"
          ]
        }
      },
      "explanationZh": "空格在 conditions（名词）前面，要用形容词。nature 的形容词是 natural（自然的）。",
      "evidence": [
        {
          "block": "p3",
          "quote": "conditions also make it a great place to use NEVs"
        }
      ]
    },
    "q5": {
      "slots": {
        "b5": {
          "accept": [
            "fewer"
          ]
        }
      },
      "explanationZh": "后面有 than，要用比较级。hours 是可数名词，few 的比较级是 fewer。",
      "evidence": [
        {
          "block": "p3",
          "quote": "low temperatures make the batteries last for"
        }
      ]
    },
    "q6": {
      "slots": {
        "b6": {
          "accept": [
            "problem"
          ]
        }
      },
      "explanationZh": "前面说低温会让电池续航变短，“可是在海南这不会是个大问题”。a big problem 就是“大问题”。",
      "evidence": [
        {
          "block": "p3",
          "quote": "won’t be a big"
        }
      ]
    },
    "q7": {
      "slots": {
        "b7": {
          "accept": [
            "warm"
          ]
        }
      },
      "explanationZh": "后面说 throughout the year（全年），海南一年四季都很暖和，所以填 warm，这样低温就不是问题了。",
      "evidence": [
        {
          "block": "p3",
          "quote": "throughout the year"
        }
      ]
    },
    "q8": {
      "slots": {
        "b8": {
          "accept": [
            "dead"
          ]
        }
      },
      "explanationZh": "空格在名词 batteries 前，要用形容词。die 的形容词是 dead，dead batteries 是“没电的电池”。",
      "evidence": [
        {
          "block": "p3",
          "quote": "NEV owners won’t have to worry about"
        }
      ],
      "tipsZh": "dead 是 die 的形容词形式"
    },
    "q9": {
      "slots": {
        "b9": {
          "accept": [
            "its"
          ]
        }
      },
      "explanationZh": "空格在名词 plan 前面，要用形容词性物主代词。it 对应 its，意思是“它的（海南的）计划”。",
      "evidence": [
        {
          "block": "p4",
          "quote": "to carry out"
        }
      ]
    },
    "q10": {
      "slots": {
        "b10": {
          "accept": [
            "more"
          ]
        }
      },
      "explanationZh": "many 的比较级是 more。气候变化是威胁，所以会有“更多”地方需要这样的努力。",
      "evidence": [
        {
          "block": "p4",
          "quote": "such efforts will be needed in"
        }
      ]
    }
  }
