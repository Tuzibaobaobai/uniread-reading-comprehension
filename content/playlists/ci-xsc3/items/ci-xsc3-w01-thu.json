            "v": "solar",
            "ref": "v-solar"
          },
          {
            "t": "text",
            "v": " energy."
          }
        ]
      },
      {
        "id": "p3",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "The island’s "
