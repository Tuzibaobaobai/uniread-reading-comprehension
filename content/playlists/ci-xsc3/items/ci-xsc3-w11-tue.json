            "prompt": [
              {
                "t": "text",
                "v": "Why has cutting down trees been banned in the planned park area?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "Because the government wants to sell the wood at a higher price later."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "Because the area will be used for building new houses."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "Because scientists want to study how trees grow in this area."
                  }
                ]
              },
              {
                "id": "D",
                "content": [
                  {
                    "t": "text",
                    "v": "Because trees are necessary for koalas’ survival as their home and food source."
                  }
                ]
              }
            ]
          }
        },
        {
