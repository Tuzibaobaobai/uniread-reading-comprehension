              {
                "t": "text",
                "v": "What is the main goal of creating the Great Koala National Park?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "To attract more tourists to Australia."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "To protect wild koalas and their living environment."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "To plant more eucalyptus trees for koalas."
                  }
                ]
              },
              {
                "id": "D",
                "content": [
                  {
                    "t": "text",
                    "v": "To help timber workers find new jobs."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q2",
          "number": 2,
          "points": 1,
          "skills": [
