            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "Where do hibernators like to stay?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "Dark places."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "Noisy places."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "Cold places."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q3",
          "number": 3,
          "points": 1,
          "skills": [
            "detail"
          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "What happens during hibernation?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "Heart beats fast."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "Body gets warm."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "Breathing slows down."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q4",
          "number": 4,
          "points": 1,
          "skills": [
            "inference"
          ],
          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "Why is hibernation more than just sleep?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "It needs special hiding places."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "It makes animals’ bodies change a lot."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "It helps animals avoid coldness completely."
                  }
                ]
              }
            ]
          }
        }
      ]
    }
