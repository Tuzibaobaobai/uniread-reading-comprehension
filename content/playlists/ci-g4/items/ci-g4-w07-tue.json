            "v": "insulation tiles",
            "zh": "隔热砖"
          },
          {
            "t": "text",
            "v": ". These tiles help keep houses warm or cool."
          }
        ]
      },
      {
        "id": "p4",
        "type": "paragraph",
        "content": [
