        "image": "img1"
      },
      {
        "id": "p3",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "Some people think it helps to keep "
          },
          {
            "t": "vocab",
            "v": "mosquitoes",
            "ref": "v-mosquito"
          },
          {
            "t": "text",
            "v": " away. The colours of the buildings look like "
