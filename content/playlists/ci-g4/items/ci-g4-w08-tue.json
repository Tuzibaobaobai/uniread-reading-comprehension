            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "Why must climbers take turns on the summit?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "Because the air is too thin."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "Because there is limited space."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "Because the weather changes quickly."
