        "level": 3,
        "content": [
          {
            "t": "gloss",
            "v": "weaver ant",
            "zh": "编织蚁"
          }
        ]
      },
      {
        "id": "p3",
        "type": "paragraph",
        "content": [
          {
            "t": "text",
            "v": "I live in the trees of Australia, too. I make my "
