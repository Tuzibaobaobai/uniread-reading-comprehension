            "prompt": [
              {
                "t": "text",
                "v": "What does “in the black” mean for stores?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "They are closing down."
                  }
                ]
              },
              {
                "id": "B",
