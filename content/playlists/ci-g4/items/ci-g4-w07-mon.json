          "interaction": {
            "kind": "choice",
            "variant": "standard",
            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "Why do people line up outside stores on Black Friday?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "To meet their friends."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "To return unwanted gifts."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "To buy Christmas presents."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q4",
          "number": 4,
          "points": 1,
          "skills": [
