                  {
                    "t": "text",
                    "v": "They are losing money."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "They are making a profit."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "q3",
          "number": 3,
          "points": 1,
          "skills": [
            "detail"
