            "maxChoices": 1,
            "prompt": [
              {
                "t": "text",
                "v": "Why is Black Friday important to stores?"
              }
            ],
            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "Stores can sell out all their products."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "It’s the only "
                  },
                  {
                    "t": "gloss",
                    "v": "discount",
                    "zh": "折扣"
                  },
                  {
                    "t": "text",
                    "v": " day."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "It marks the start of the profit season."
                  }
                ]
