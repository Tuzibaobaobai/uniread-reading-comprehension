          "interaction": {
            "kind": "speaking",
            "prompt": [
              {
                "t": "text",
                "v": "Look at the pictures of different things to wear. Say if you like them and why or why not, then answer the examiner’s questions."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "Here are some pictures that show different things to wear. Do you like these different things to wear? Say why or why not.",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q2-t1.mp3",
                  "seconds": 9.3
                }
              },
              {
                "id": "t2",
                "text": "Do you think wearing jeans is boring? Why? / Why not?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q2-t2.mp3",
                  "seconds": 5.2
                }
              },
              {
                "id": "t3",
                "text": "Do you think wearing sunglasses is important? Why? / Why not?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q2-t3.mp3",
                  "seconds": 5.7
                }
              },
              {
                "id": "t4",
                "text": "Do you think wearing trainers is cool? Why? / Why not?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q2-t4.mp3",
                  "seconds": 5.5
                }
              },
              {
                "id": "t5",
                "text": "Do you think wearing a cap in the sun is a good idea? Why? / Why not?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q2-t5.mp3",
                  "seconds": 6.4
                }
              },
              {
                "id": "t6",
                "text": "Do you think wearing a watch is useful? Why? / Why not?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q2-t6.mp3",
                  "seconds": 5.6
                }
              },
              {
                "id": "t7",
                "text": "So, which of these things to wear do you like best?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q2-t7.mp3",
                  "seconds": 4.8
                }
              },
              {
                "id": "t8",
                "text": "Now, do you prefer wearing a watch or using your phone to tell the time? Why?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q2-t8.mp3",
                  "seconds": 7.2
                }
              },
              {
                "id": "t9",
                "text": "What kind of jewellery can you wear at school? Why?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q2-t9.mp3",
                  "seconds": 4.4
                }
              }
            ],
            "maxSeconds": 45,
            "scoring": "judge"
          }
        }
      ]
