              {
                "t": "text",
                "v": "Answer the examiner’s questions about yourself, weekends and languages."
              }
            ],
            "turns": [
              {
                "id": "t1",
                "text": "What’s your name?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q1-t1.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t2",
                "text": "How old are you?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q1-t2.mp3",
                  "seconds": 2
                }
              },
              {
                "id": "t3",
                "text": "Where do you live?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q1-t3.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t4",
                "text": "Now, let’s talk about weekends. What’s your favourite day at the weekend?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q1-t4.mp3",
                  "seconds": 6.3
                }
              },
              {
                "id": "t5",
                "text": "What do you usually eat for lunch at the weekend?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q1-t5.mp3",
                  "seconds": 3.8
                }
              },
              {
                "id": "t6",
                "text": "Now, please tell me something about a weekend that you enjoyed.",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q1-t6.mp3",
                  "seconds": 4.6
                }
              },
              {
                "id": "t7",
                "text": "Now, let’s talk about languages. How often do you speak English?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q1-t7.mp3",
                  "seconds": 5.9
                }
              },
              {
                "id": "t8",
                "text": "What is easy for you about learning a new language?",
                "audio": {
                  "src": "assets/ket1/ket1-t1-s-q1-t8.mp3",
                  "seconds": 4.3
                }
              }
            ],
            "maxSeconds": 30,
            "scoring": "judge"
          }
        }
      ]
    },
    {
      "id": "s2",
      "part": 2,
      "label": "Part 2",
      "instruction": "Look at the pictures and talk about them with the examiner.",
      "questions": [
        {
          "id": "q2",
          "number": 2,
          "points": 15,
          "skills": [],
          "material": [
            {
              "id": "i1",
