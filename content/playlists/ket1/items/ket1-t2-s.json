            "turns": [
              {
                "id": "t1",
                "text": "What’s your name?",
                "audio": {
                  "src": "assets/ket1/ket1-t2-s-q1-t1.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t2",
                "text": "How old are you?",
                "audio": {
                  "src": "assets/ket1/ket1-t2-s-q1-t2.mp3",
                  "seconds": 2
                }
              },
              {
                "id": "t3",
                "text": "Where do you live?",
                "audio": {
                  "src": "assets/ket1/ket1-t2-s-q1-t3.mp3",
                  "seconds": 1.9
                }
              },
              {
                "id": "t4",
                "text": "Now, let’s talk about films. How often do you go to the cinema?",
                "audio": {
                  "src": "assets/ket1/ket1-t2-s-q1-t4.mp3",
                  "seconds": 5.8
                }
              },
              {
                "id": "t5",
                "text": "Who do you usually watch films with?",
                "audio": {
                  "src": "assets/ket1/ket1-t2-s-q1-t5.mp3",
                  "seconds": 3
                }
              },
              {
                "id": "t6",
                "text": "Now, please tell me something about a film you have watched.",
                "audio": {
                  "src": "assets/ket1/ket1-t2-s-q1-t6.mp3",
                  "seconds": 4.5
                }
              },
              {
                "id": "t7",
                "text": "Now, let’s talk about transport. How long is your journey to school?",
                "audio": {
                  "src": "assets/ket1/ket1-t2-s-q1-t7.mp3",
                  "seconds": 6.6
                }
              },
              {
                "id": "t8",
                "text": "What is the best way to travel around your area?",
                "audio": {
                  "src": "assets/ket1/ket1-t2-s-q1-t8.mp3",
                  "seconds": 4
                }
              }
            ],
            "maxSeconds": 30,
            "scoring": "judge"
          }
        }
      ]
