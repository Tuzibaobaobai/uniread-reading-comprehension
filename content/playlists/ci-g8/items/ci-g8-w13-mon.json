            "options": [
              {
                "id": "A",
                "content": [
                  {
                    "t": "text",
                    "v": "To warn about the dangers of falling from a high place."
                  }
                ]
              },
              {
                "id": "B",
                "content": [
                  {
                    "t": "text",
                    "v": "To explain why the egg breaks easily in the egg drop challenge."
                  }
                ]
              },
              {
                "id": "C",
                "content": [
                  {
                    "t": "text",
                    "v": "To teach people how to protect themselves when they fall from a height."
                  }
                ]
              },
              {
                "id": "D",
                "content": [
                  {
                    "t": "text",
                    "v": "To help people understand why eggs that land on their sides are less likely to break."
                  }
                ]
              }
            ]
          }
        },
        {
