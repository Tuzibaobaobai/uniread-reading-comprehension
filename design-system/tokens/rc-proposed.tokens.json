{
  "$description": "RC proposals to the UniRead design system (docs/14 §15, stage 3) — pending approval by the UniRead designer. Semantic colours alias existing UniRead primitives / paint styles (the design system's own P1: 'add a Semantic role collection'); spacing / size are new scales. Edited by hand; ds-build marks every token 'proposed'.",
  "variables": {
    "color": {
      "text": {
        "primary": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/Grey/13(text)",
              "use": "body and titles"
            }
          }
        },
        "strong": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/Grey/12",
              "use": "emphasised labels"
            }
          }
        },
        "secondary": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/Grey/10",
              "use": "meta, captions"
            }
          }
        },
        "tertiary": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/Grey/9",
              "use": "placeholders, hints"
            }
          }
        },
        "on-action": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "color/white/100",
              "use": "text on brand fill"
            }
          }
        },
        "answer": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/Primary Blue/Cyan",
              "use": "the learner's typed answers (must differ from vocab highlight)"
            }
          }
        }
      },
      "icon": {
        "strong": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/Grey/14",
              "use": "dark chevrons / select icons"
            }
          }
        }
      },
      "background": {
        "page": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/Grey/2"
            }
          }
        },
        "card": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "color/white/100"
            }
          }
        },
        "subtle": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/Grey/2"
            }
          }
