        "$value": "1.5px",
        "$extensions": {
          "rc": {
            "status": "needs-designer",
            "use": "填空下划线"
          }
        }
      },
      "progress": {
        "$type": "dimension",
        "$value": "2px",
        "$extensions": {
          "rc": {
            "status": "needs-designer",
            "use": "进度条"
          }
        }
      },
      "criteria": {
        "$type": "dimension",
        "$value": "6px",
        "$extensions": {
          "rc": {
            "status": "needs-designer",
            "use": "评分维度条"
          }
        }
      },
      "default": {
        "$type": "dimension",
        "$value": "1px",
        "$extensions": {
          "rc": {
            "use": "hairline borders (cards, inputs, buttons)"
