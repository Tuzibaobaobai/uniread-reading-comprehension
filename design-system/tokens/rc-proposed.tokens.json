              "use": "连线题配对标记（需 7 种可区分颜色）"
            }
          }
        },
        "2": {
          "$type": "color",
          "$value": "rgba(62, 142, 247, 1)",
          "$extensions": {
            "rc": {
              "status": "needs-designer",
              "use": "连线题配对标记（需 7 种可区分颜色）"
            }
          }
        },
        "3": {
          "$type": "color",
          "$value": "rgba(47, 163, 107, 1)",
          "$extensions": {
            "rc": {
              "status": "needs-designer",
              "use": "连线题配对标记（需 7 种可区分颜色）"
            }
          }
        },
        "4": {
          "$type": "color",
          "$value": "rgba(166, 92, 232, 1)",
          "$extensions": {
            "rc": {
              "status": "needs-designer",
              "use": "连线题配对标记（需 7 种可区分颜色）"
            }
          }
        },
        "5": {
          "$type": "color",
          "$value": "rgba(229, 164, 0, 1)",
          "$extensions": {
            "rc": {
              "status": "needs-designer",
              "use": "连线题配对标记（需 7 种可区分颜色）"
            }
          }
        },
        "6": {
          "$type": "color",
          "$value": "rgba(229, 72, 77, 1)",
          "$extensions": {
            "rc": {
              "status": "needs-designer",
              "use": "连线题配对标记（需 7 种可区分颜色）"
            }
          }
        },
        "7": {
          "$type": "color",
          "$value": "rgba(23, 162, 184, 1)",
          "$extensions": {
            "rc": {
              "status": "needs-designer",
              "use": "连线题配对标记（需 7 种可区分颜色）"
            }
          }
        }
      }
    },
    "space": {
      "2": {
        "$type": "dimension",
        "$value": "2px"
      },
      "4": {
        "$type": "dimension",
        "$value": "4px"
      },
      "8": {
