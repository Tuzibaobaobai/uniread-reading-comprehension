        "track": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/Grey/4",
              "use": "audio / progress track"
            }
          }
        },
        "highlight": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/Chart/1 #3",
              "use": "evidence sentence in the article"
            }
          }
        },
        "highlight-strong": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/Chart/2 #3",
              "use": "locate flash"
            }
          }
        },
        "overlay-panel": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "color/white/80"
            }
