        "success-bg": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/success-bg"
            }
          }
        },
        "error": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/State/wrong-light"
            }
          }
        },
        "error-bg": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/error-bg"
