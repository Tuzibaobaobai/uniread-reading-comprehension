    "size": {
      "touch-target": {
        "$type": "dimension",
        "$value": "44px",
        "$extensions": {
          "rc": {
            "use": "minimum tap target (WCAG 2.5.5 / Apple HIG); at the 1000px design width"
          }
        }
      },
      "icon": {
        "s": {
          "$type": "dimension",
          "$value": "20px"
        },
        "m": {
          "$type": "dimension",
          "$value": "24px"
        },
        "l": {
          "$type": "dimension",
          "$value": "32px"
        },
        "xl": {
          "$type": "dimension",
          "$value": "40px"
        }
      }
    },
    "opacity": {
      "disabled": {
        "$type": "number",
        "$value": "0.2",
        "$extensions": {
          "rc": {
            "status": "needs-designer",
            "use": "禁用态（UniRead 组件各自定义禁用态）"
          }
        }
      }
    },
    "blur": {
      "panel": {
        "$type": "dimension",
        "$value": "100px",
        "$extensions": {
          "rc": {
            "status": "needs-designer",
            "use": "合集信息面板背景模糊（UniRead blur/glass 为 10px）"
          }
        }
      }
    },
    "stroke": {
