          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "paint/Customization/Grey/5(divider)"
            }
          }
        }
      },
      "action": {
        "primary": {
          "$type": "color",
          "$value": null,
          "$extensions": {
            "rc": {
              "alias": "color/brand/6"
