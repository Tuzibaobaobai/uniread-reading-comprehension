            }
          }
        },
        "success-text": {
          "$type": "color",
          "$value": "rgba(73, 114, 73, 1)",
          "$extensions": {
            "rc": {
              "status": "needs-designer",
              "use": "解析文字在 success-bg 上（UniRead finished-dark 对比度不足）"
            }
          }
        },
        "success-divider": {
          "$type": "color",
          "$value": "rgba(73, 114, 73, 0.2)",
          "$extensions": {
            "rc": {
